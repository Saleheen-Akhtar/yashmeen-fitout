MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/yashmeen_db?retryWrites=true&w=majority
PORT=8000

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=7d
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# GMAIL SMTP App passwords
SMTP_PASS=your_smtp_app_password
SMTP_USER=yashmeenbuilding@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=Yashmeen Future Building <yashmeenbuilding@gmail.com>

# Frontend URL. Use the noindex Vercel preview hostname during preview checks,
# then switch both values to https://www.yfbfitoutcontracting.com for launch.
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional: allow Vercel preview deployments (yashmeen-fitout-*.vercel.app) through CORS
ALLOW_VERCEL_PREVIEWS=false
# Set true when running behind your own reverse proxy (auto-enabled on Vercel)
TRUST_PROXY=false

# Durable media storage
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_api_secret

# Distributed serverless rate limiting
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token

# Optional migration report/backup directory
MIGRATION_OUTPUT_DIR=./migration-output
